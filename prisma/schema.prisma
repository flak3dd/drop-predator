generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Drop {
  id          String        @id @default(uuid())
  shop        String
  title       String
  description String        @default("")
  status      String        @default("DRAFT")
  scheduledAt    DateTime?
  scheduledEndAt DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       DropProduct[]

  @@index([shop, status])
  @@index([shop, scheduledAt])
  @@index([shop, createdAt])
  @@index([status, scheduledAt])
  @@index([status, scheduledEndAt])
}

model DropProduct {
  id                String   @id @default(uuid())
  dropId            String
  drop              Drop     @relation(fields: [dropId], references: [id], onDelete: Cascade)
  productId         String
  productTitle      String
  productImage      String   @default("")
  allocatedQuantity Int      @default(0)
  dropPrice         String   @default("")
  originalPrice     String   @default("")
  createdAt         DateTime @default(now())

  @@index([dropId])
  @@index([productId])
  @@unique([dropId, productId])
}

model Setting {
  id              String  @id @default(uuid())
  shop            String  @unique
  autoActivate    Boolean @default(false)
  autoRevertPrice Boolean @default(true)
  autoPublish     Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  engineConfig    String? @default("{}")
}

model EngineRun {
  id          String   @id @default(uuid())
  shop        String
  niche       String
  status      String   @default("RUNNING")
  phase       Int      @default(0)
  phaseSub    String   @default("")
  config      String   @default("{}")
  logs        String   @default("[]")
  dealsClosed     Int      @default(0)
  sessionRev      Int      @default(0)
  brandResearch   String   @default("{}")
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  products        EngineProduct[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, status])
  @@index([shop, startedAt])
}

model EngineProduct {
  id                String   @id @default(uuid())
  engineRunId       String?
  engineRun         EngineRun? @relation(fields: [engineRunId], references: [id], onDelete: Cascade)
  shop              String
  sourceId          String
  name              String
  category          String
  score             Int      @default(0)
  margin            Int      @default(0)
  price             Float    @default(0)
  cost              Float    @default(0)
  landedCost        Float    @default(0)
  velocity          Int      @default(0)
  trend             Int      @default(0)
  lifecycle         String   @default("mature")
  competition       String   @default("medium")
  supplier          String
  supplierScore     Int      @default(0)
  moq               Int      @default(0)
  discount          Int      @default(0)
  sources           String   @default("[]")
  searches          Int      @default(0)
  impulse           Int      @default(0)
  warnings          String   @default("[]")
  negState          Int      @default(0)
  activePrice       String   @default("standard")
  discountImproved  Int      @default(0)
  moqImproved       Int      @default(0)
  aiNegotiated      Boolean  @default(false)
  imported          Boolean  @default(false)
  shopifyProductId  String?
  seoTitle          String?
  brandKeywords     String   @default("[]")
  aliProductId      String?  // AliExpress DS product ID for auto-fulfillment
  listing           ProductListing?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([engineRunId, sourceId])
  @@index([shop, imported])
  @@index([shop, score])
  @@index([shop, lifecycle])
  @@index([engineRunId])
  @@index([sourceId])
  @@index([imported, createdAt])
}

model ProductListing {
  id               String   @id @default(uuid())
  engineProductId  String   @unique
  engineProduct    EngineProduct @relation(fields: [engineProductId], references: [id], onDelete: Cascade)
  title            String
  description      String
  descriptionHtml  String
  bulletPoints     String   @default("[]")
  seoTags          String   @default("[]")
  metaDescription  String
  collections      String   @default("[]")
  pricingCopy      String
  productType      String
  aiGenerated      Boolean  @default(false)
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── AliExpress DS Integration ──────────────────────────────────────────────

/// Stores per-shop OAuth2 credentials for the AliExpress DS API.
/// Obtained via the "Connect AliExpress" OAuth flow in Settings.
model AliCredential {
  id                 String   @id @default(uuid())
  shop               String   @unique
  accessToken        String
  refreshToken       String
  accessTokenExpiry  DateTime
  refreshTokenExpiry DateTime
  aliUserId          String   @default("")
  aliUserNick        String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([shop])
}

/// Tracks AliExpress DS orders placed from Shopify order events.
/// Created when a Shopify order is paid and auto-fulfillment is active,
/// or when the merchant manually triggers "Order from AliExpress".
model AliOrder {
  id              String   @id @default(uuid())
  shop            String

  // Shopify side
  shopifyOrderId  String               // Shopify order GID or numeric ID
  shopifyOrderNum String   @default("") // Human-readable #1001

  // AliExpress side
  aliOrderId      String?              // Set after successful order placement
  aliProductId    String   @default("")
  productName     String
  quantity        Int      @default(1)
  skuAttr         String   @default("")
  shippingService String   @default("CAINIAO_STANDARD")

  // Costs
  productCost     Float    @default(0)
  shippingCost    Float    @default(0)
  totalCost       Float    @default(0)
  currency        String   @default("USD")

  // Shipping address (JSON, mirrors Shopify address)
  buyerAddress    String   @default("{}")

  // Fulfillment status
  status          String   @default("PENDING")
  // PENDING → PLACING → PLACED → SHIPPED → DELIVERED | FAILED | CANCELLED

  // Tracking
  trackingNumber  String?
  trackingUrl     String?
  carrierCode     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  // Error info
  errorCode       String?
  errorMsg        String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop, status])
  @@index([shopifyOrderId])
  @@index([aliOrderId])
  @@index([shop, createdAt])
}
