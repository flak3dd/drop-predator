{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Shopify App Dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "Vite Dev Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["react-router", "dev"],
      "port": 3000
    },
    {
      "name": "Production Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["react-router-serve", "./build/server/index.js"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Test Watcher",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vitest"],
      "port": 0
    },
    {
      "name": "Brand Research Service",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--port", "8765"],
      "cwd": "python/brand-research",
      "port": 8765
    }
  ]
}
