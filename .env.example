# ─── Shopify App ──────────────────────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=read_products,write_products

# ─── Shopify Admin (direct API access for cron & webhooks) ────────────────────
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_TOKEN=your_shopify_admin_token
SHOP_CUSTOM_DOMAIN=your-store.myshopify.com

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── AI Gateway (Vercel) ──────────────────────────────────────────────────────
# Get from: vercel.com → Settings → Tokens
# On Vercel deployments VERCEL_OIDC_TOKEN is auto-injected; this is the local fallback.
AI_GATEWAY_API_KEY=your_vercel_token

# ─── AI Providers (Optional — used when gateway is unavailable) ───────────────
ANTHROPIC_API_KEY=

# ─── Search (Optional — Google Trends enrichment in engine scout) ─────────────
SERPAPI_KEY=

# ─── Cron Auth ────────────────────────────────────────────────────────────────
# Generate any random secret: openssl rand -hex 32
# Must match CRON_SECRET set in Vercel env vars.
CRON_SECRET=your_random_cron_secret

# ─── Dropshipping Integrations (Optional) ────────────────────────────────────
CJ_EMAIL=
CJ_PASSWORD=
ALI_APP_KEY=
ALI_APP_SECRET=

# ─── WooCommerce (Optional) ───────────────────────────────────────────────────
WC_URL=
WC_KEY=

# ─── Development ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_PORT=8002
# Set to true to skip Shopify OAuth in local dev
DEV_BYPASS_AUTH=true
